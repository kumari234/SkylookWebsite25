<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Our Ventures - Skylook Developers & Constructions</title>
    <link rel="stylesheet" href="assets/css/style.css">
</head>

<body>

    <!-- Header -->
    <header class="main-header">
        <div class="logo">
            <img src="assets/images/logo.png" alt="Skylook Developers & Constructions Logo">
            <span>Skylook Developers & Constructions</span>
        </div>
        <nav class="main-nav">
            <a href="index.jsp">Home</a>
            <a href="about.jsp">About</a>
            <a href="ventures.jsp">Ventures</a>
            <a href="contact.jsp">Contact</a>
        </nav>
    </header>

    <!-- Hero Section for Ventures -->
    <section class="hero-section">
        <div class="hero-content">
            <h2>Our Ventures</h2>
            <p>Explore our ongoing and completed real estate ventures.</p>
        </div>
    </section>

    <!-- Running Ventures Section -->
    <section class="running-ventures">
        <div class="container">
            <h2>Running Ventures</h2>
            <div class="ventures-list">
                <div class="venture-box">
                    <img src="assets/images/venture1.jpg" alt="Venture 1">
                    <h3>Kothavalasa Plot</h3>
                    <p>VMRDA approved plots available with prime location for investment.</p>
                    <ul>
                        <li>Price: ₹1500 per Sq.Yd</li>
                        <li>Size: 1000 - 5000 Sq.Yds</li>
                    </ul>
                </div>
                <div class="venture-box">
                    <img src="assets/images/venture2.jpg" alt="Venture 2">
                    <h3>Bogapuram Land</h3>
                    <p>Farmland plots available for agricultural and residential use.</p>
                    <ul>
                        <li>Price: ₹1200 per Sq.Yd</li>
                        <li>Size: 500 - 3000 Sq.Yds</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Completed Ventures Section -->
    <section class="completed-ventures">
        <div class="container">
            <h2>Completed Ventures</h2>
            <div class="ventures-list">
                <div class="venture-box">
                    <img src="assets/images/completed-venture1.jpg" alt="Completed Venture 1">
                    <h3>Anandapuram Project</h3>
                    <p>Completed and handed over to customers with full amenities.</p>
                </div>
                <div class="venture-box">
                    <img src="assets/images/completed-venture2.jpg" alt="Completed Venture 2">
                    <h3>Chodavaram Plots</h3>
                    <p>All plots have been sold and successfully developed.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Price List Section -->
    <section class="price-list">
        <div class="container">
            <h2>Price List</h2>
            <table>
                <thead>
                    <tr>
                        <th>Venture Name</th>
                        <th>Price per Sq.Yd</th>
                        <th>Size Range</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Kothavalasa Plot</td>
                        <td>₹1500</td>
                        <td>1000 - 5000 Sq.Yds</td>
                    </tr>
                    <tr>
                        <td>Bogapuram Land</td>
                        <td>₹1200</td>
                        <td>500 - 3000 Sq.Yds</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- Footer -->
    <footer class="main-footer">
        <p>&copy; 2025 Skylook Developers & Constructions | All Rights Reserved.</p>
    </footer>

    <!-- Transparent Logo (Fixed Background) -->
    <div class="background-logo">
        <img src="assets/images/logo.png" alt="Skylook Logo">
    </div>

</body>

</html>

